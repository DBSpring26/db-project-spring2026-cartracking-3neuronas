# Copy to .env and fill in values. Never commit .env.

# --- Local Docker (postgres + api + web) ---
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me-local-db-password
POSTGRES_DB=car_tracking

DB_HOST=postgres
DB_NAME=car_tracking
DB_USER=admin
DB_PASSWORD=change-me-local-db-password
DB_PORT=5432

# --- Streamlit web app ---
API_BASE_URL=http://api:8000/api/v1
# Public API URL for cloud AI agent / external tools (Render in production)
PUBLIC_API_BASE_URL=http://api:8000/api/v1

# --- AI Assistant (Cursor SDK) ---
CURSOR_API_KEY=
CURSOR_AGENT_RUNTIME=local

# --- Render production DB (ETL only — set when running ETL against Render) ---
# DB_HOST=your-render-host.onrender.com
# DB_NAME=your_db_name
# DB_USER=your_db_user
# DB_PASSWORD=your_render_db_password
# DB_PORT=5432
